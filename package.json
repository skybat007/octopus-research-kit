{
  "name": "octopus-research-kit",
  "version": "0.1.0",
  "description": "An evidence-backed research kit for source reading, framework analysis, technology evaluation, and architecture research.",
  "license": "MIT",
  "private": false,
  "keywords": [
    "tech-research",
    "source-code-analysis",
    "software-architecture",
    "open-source",
    "ai-agent",
    "evidence-backed-documentation"
  ],
  "scripts": {
    "research:sanitize": "node docs/tech-research-guide/scripts/sanitize-research-privacy.js",
    "research:dashboard": "node docs/tech-research-guide/scripts/build-research-dashboard.js",
    "research:validate": "node docs/tech-research-guide/scripts/validate-research.js",
    "research:validate:strict": "node docs/tech-research-guide/scripts/validate-research.js --strict",
    "release:check": "node docs/tech-research-guide/scripts/check-release-safety.js",
    "test": "npm run research:validate && npm run release:check"
  },
  "engines": {
    "node": ">=18"
  }
}
